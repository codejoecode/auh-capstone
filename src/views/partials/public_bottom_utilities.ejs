      data-utility-trigger
      aria-label="Toggle social links"
      aria-expanded="false"
    >
      Socials
    </button>

    <ul class="public-bottom-utility__items" aria-label="Social links">
      <li class="public-bottom-utility__item">
        <a
          class="public-bottom-utility__link"
          href="https://www.instagram.com/allunderhvn/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          data-utility-child
        >
          <img class="public-bottom-utility__icon" src="/images/social-instagram.png" alt="" aria-hidden="true" />
        </a>
      </li>
      <li class="public-bottom-utility__item">
        <a
          class="public-bottom-utility__link"
          href="https://www.facebook.com/people/All-under-heaven/100064778059647/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          data-utility-child
        >
          <img class="public-bottom-utility__icon" src="/images/social-facebook.png" alt="" aria-hidden="true" />
        </a>
      </li>
      <li class="public-bottom-utility__item">
        <a
          class="public-bottom-utility__link"
          href="https://x.com/allunderhvn"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="X"
          data-utility-child
        >
          <img class="public-bottom-utility__icon" src="/images/social-x.png" alt="" aria-hidden="true" />
        </a>
      </li>
    </ul>
  </div>

  <div class="public-bottom-utility__group public-bottom-utility__group--info" data-utility-group>
    <button
      type="button"
      class="public-bottom-utility__trigger"
      data-utility-trigger
      aria-label="Toggle information links"
      aria-expanded="false"
    >
      Info
    </button>

    <ul class="public-bottom-utility__items" aria-label="Information links">
      <li class="public-bottom-utility__item">
        <a class="public-bottom-utility__link public-bottom-utility__link--text" href="/contact" data-utility-child>Contact</a>
      </li>
      <li class="public-bottom-utility__item">
        <a class="public-bottom-utility__link public-bottom-utility__link--text" href="/shipping" data-utility-child>Shipping</a>
      </li>
      <li class="public-bottom-utility__item">
        <a class="public-bottom-utility__link public-bottom-utility__link--text" href="/returns" data-utility-child>Returns</a>
      </li>
    </ul>
  </div>
</aside>
